{
  "name": "cute-island",
  "version": "0.1.18",
  "private": true,
  "description": "跨平台 PC 灵动岛，展示 agent 执行状态",
  "author": "Cute Island <xihadance@gmail.com>",
  "license": "MIT",
  "main": "./out/main/index.js",
  "bin": {
    "cute-island": "./bin/cute-island.js"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build && npm run build:cli",
    "build:cli": "esbuild src/cli.ts --bundle --minify --packages=external --platform=node --format=cjs --outfile=out/cli.cjs",
    "dist": "npm run typecheck && npm test && npm run build && electron-builder --publish never",
    "pack": "npm run build && electron-builder --dir --publish never",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "island": "tsx src/cli.ts",
    "postinstall": "patch-package --error-on-fail"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "com.cuteisland.app",
    "productName": "Cute Island",
    "icon": "build/icon.png",
    "publish": [
      {
        "provider": "github",
        "owner": "xihadance",
        "repo": "cute-island"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/main/**/*",
      "out/preload/**/*",
      "out/renderer/**/*",
      "out/cli.cjs",
      "bin/cute-island.js",
      "package.json"
    ],
    "asar": true,
    "compression": "maximum",
    "artifactName": "${name}-${version}-${arch}.${ext}",
    "electronLanguages": [
      "en-US",
      "zh-CN",
      "zh-TW"
    ],
    "npmRebuild": false,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Cute Island <xihadance@gmail.com>"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${name}-setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    }
  },
  "dependencies": {
    "@discordjs/ws": "1.2.3",
    "@larksuiteoapi/node-sdk": "^1.74.0",
    "@wecom/aibot-node-sdk": "^1.0.7",
    "axios": "^1.20.0",
    "discord.js": "^14.27.0",
    "electron-updater": "6.8.10",
    "node-fetch": "^2.7.0",
    "patch-package": "^8.0.1",
    "proxy-agent": "^6.5.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/node-fetch": "^2.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "acorn": "^8.19.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "framer-motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
